# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk,go.mod,go.sum}]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf

# Ecosystem modules append their sections below (C#, Python, ...).
