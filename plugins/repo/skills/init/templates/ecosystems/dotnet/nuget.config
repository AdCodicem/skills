<?xml version="1.0" encoding="utf-8"?>
<!--
  One source, nuget.org, over HTTPS: machine-level feeds never leak into the
  build. With a second source, add packageSourceMapping (NU1507 otherwise), so
  no package can be resolved from the wrong feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
