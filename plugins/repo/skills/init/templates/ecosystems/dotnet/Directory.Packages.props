<Project>

  <!--
    Central Package Management: every package version lives here, projects write
    <PackageReference Include="Name" /> without a version. Renovate updates this
    file; the versions below are refreshed by scripts/latest_versions.py when the
    repository is set up.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning lets a PackageVersion entry raise a transitive dependency
      (to pull a fix for an advisory, for example). In a library, a pinned
      transitive package becomes a direct dependency of the packed package: pin a
      transitive package only when consumers should get that version too.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Tests">
    <!-- xUnit v3 runs on Microsoft.Testing.Platform; no Microsoft.NET.Test.Sdk is needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- Integration tests: add the module of the service under test (Testcontainers.PostgreSql, ...). -->
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
