{
  "config": {
    "default": true,
    // Long lines are fine in prose and tables.
    "MD013": false,
    // Allow inline HTML (badges, <details>).
    "MD033": false,
    // SKILL.md and agent files start with YAML frontmatter, not a heading.
    "MD041": false,
    // Repeated headings are common in changelogs and reference docs.
    "MD024": { "siblings_only": true }
  },
  "ignores": [
    "**/node_modules/**",
    ".venv/**",
    "venv/**",
    "**/CHANGELOG.md",
    "**/evals/**",
    "plugins/*/skills/*/templates/**",
    "templates/**",
    "dist/**"
  ]
}
